{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Keeps the product's former name on purpose: renaming a deployed Worker creates a new one without its secret and custom domain.
  "name": "powertools-feedback",
  "main": "src/index.ts",
  // Matches the workerd that ships with the installed wrangler; a newer date makes wrangler warn.
  "compatibility_date": "2026-10-23",
  "routes": [{ "pattern": "wlfeedback.siazon.cc", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "feedback",
      "database_id": "7a41cb3f-10a2-44fa-a044-c2e962a357fb",
      "migrations_dir": "migrations"
    }
  ]
}
