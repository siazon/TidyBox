<Page
    x:Class="PowerTools.App.Views.ContextMenuView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PowerTools.App.Views">

    <Grid Margin="24,16,24,16" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="8">
        <Border Padding="16,12" CornerRadius="6" BorderThickness="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="恢复完整（经典）右键菜单" FontWeight="SemiBold" />
                    <TextBlock Text="开启后，右键直接显示完整菜单，不用再点“显示更多选项”。更改需要重启资源管理器后才会生效。这里的设置保存在 Windows 注册表中，卸载本应用不会自动恢复。"
                               TextWrapping="Wrap" Opacity="0.7" />
                </StackPanel>
                <ToggleSwitch x:Name="ClassicSwitch" Grid.Column="1" OnContent="已开启" OffContent="已关闭" Toggled="OnClassicToggled"
                              AutomationProperties.Name="恢复完整（经典）右键菜单" />
                <Button x:Name="RestartButton" Grid.Column="2" Content="重启资源管理器" Click="OnRestartClick" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Border Padding="16,12" CornerRadius="6" BorderThickness="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="在右键菜单中添加“分析此文件夹”" FontWeight="SemiBold" />
                    <TextBlock Text="开启后，右键点一个文件夹，或在文件夹空白处右键，都会出现“分析此文件夹（PowerTools）”，并用磁盘空间分析打开它。立即生效，不需要重启资源管理器。这里的设置保存在 Windows 注册表中，卸载本应用不会自动删除；要移除请先在这里关闭。"
                               TextWrapping="Wrap" Opacity="0.7" />
                </StackPanel>
                <ToggleSwitch x:Name="AnalyzeSwitch" Grid.Column="1" OnContent="已开启" OffContent="已关闭" Toggled="OnAnalyzeToggled"
                              AutomationProperties.Name="在右键菜单中添加分析此文件夹" />
            </Grid>
        </Border>
        </StackPanel>

        <InfoBar x:Name="RestartHint" Grid.Row="1" IsOpen="False" Severity="Informational" Title="需要重启资源管理器"
                 Message="扩展类的菜单项和经典菜单开关，要重启资源管理器后才会生效；命令类的菜单项立即生效。" />

        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" PlaceholderText="搜索名称、发布者、路径…" TextChanged="OnSearchChanged" />
            <Button x:Name="RestoreAllButton" Grid.Column="1" Content="恢复全部已停用的项" Click="OnRestoreAllClick"
                    ToolTipService.ToolTip="把所有已停用的右键菜单项重新启用" />
        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="3" TextWrapping="Wrap" Text="正在读取右键菜单…" />

        <ListView x:Name="MenuList" Grid.Row="4" SelectionMode="None">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="MinHeight" Value="40" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:MenuRow">
                    <Grid>
                        <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" Margin="0,12,0,4"
                                   Visibility="{x:Bind local:ContextMenuView.Show(IsHeader)}" />

                        <Grid ColumnSpacing="12" Visibility="{x:Bind local:ContextMenuView.ShowNot(IsHeader)}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            <ToggleSwitch Grid.Column="0" MinWidth="0" OnContent="" OffContent=""
                                          IsOn="{x:Bind IsOn, Mode=OneWay}" IsEnabled="{x:Bind CanToggle}" Toggled="OnEntryToggled"
                                          AutomationProperties.Name="{x:Bind DisplayName}"
                                          ToolTipService.ToolTip="{x:Bind ToggleTooltip, Mode=OneWay}" />
                            <TextBlock Grid.Column="1" Text="{x:Bind DisplayName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{x:Bind KindText}" Opacity="0.6" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="{x:Bind Detail}" TextTrimming="CharacterEllipsis" Opacity="0.7" VerticalAlignment="Center"
                                       ToolTipService.ToolTip="{x:Bind Detail}" />
                        </Grid>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
