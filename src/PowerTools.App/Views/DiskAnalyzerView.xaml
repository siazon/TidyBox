<Page
    x:Class="PowerTools.App.Views.DiskAnalyzerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PowerTools.App.Views">

    <Grid Margin="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource TitleTextBlockStyle}" Text="磁盘空间分析" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <Button x:Name="ScanButton" Content="扫描文件夹…" Click="OnScanClick" />
            <ToggleButton x:Name="CompareToggle" Content="与上次对比" IsEnabled="False"
                          Checked="OnCompareChecked" Unchecked="OnCompareUnchecked" />
            <ProgressRing x:Name="BusyRing" IsActive="False" Width="20" Height="20" />
        </StackPanel>

        <TextBlock x:Name="StatusText" Grid.Row="2" TextWrapping="Wrap"
                   Text="点击“扫描文件夹…”选择要分析的文件夹。" />

        <ListView x:Name="ResultList" Grid.Row="3" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:ResultRow">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="{x:Bind Detail}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock x:Name="GamesHeader" Grid.Row="4" Style="{StaticResource SubtitleTextBlockStyle}" Text="Steam 游戏库" />

        <ListView x:Name="GamesList" Grid.Row="5" SelectionMode="None" MaxHeight="240">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:GameRow">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{x:Bind Detail}" VerticalAlignment="Center" />
                        <Button Grid.Column="2" Content="卸载" Tag="{x:Bind AppId}" Click="OnUninstallClick" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
