<Page
    x:Class="PowerTools.App.Views.DiskAnalyzerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PowerTools.App.Views"
    xmlns:tree="using:PowerTools.Modules.DiskAnalyzer.Tree">

    <Page.Resources>
        <LinearGradientBrush x:Key="FolderBarBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FFFFF1C2" Offset="0" />
            <GradientStop Color="#FFFFD34E" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="PercentBarBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FFB9B8FF" Offset="0" />
            <GradientStop Color="#FF7B79F5" Offset="1" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="FolderIconBrush" Color="#FFF2B31B" />
    </Page.Resources>

    <Grid Margin="24,16,24,16" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="PathBox" PlaceholderText="输入或选择要分析的文件夹，例如 D:\" KeyDown="OnPathKeyDown" />
            <Button x:Name="BrowseButton" Grid.Column="1" Content="浏览…" Click="OnBrowseClick" />
            <Button x:Name="ScanButton" Grid.Column="2" Content="扫描" Style="{StaticResource AccentButtonStyle}" Click="OnScanClick" />
            <ProgressRing x:Name="BusyRing" Grid.Column="3" IsActive="False" Width="20" Height="20" />
        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="1" TextWrapping="Wrap"
                   Text="输入文件夹路径后点击“扫描”，或点击“浏览…”选择文件夹。" />

        <Pivot Grid.Row="2">
            <PivotItem Header="文件夹">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Column widths here must match the row template below. -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="110" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="NameHeader" Grid.Column="0" Tag="Name" Click="OnHeaderClick"
                                Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Content="名称" />
                        <Button x:Name="SizeHeader" Grid.Column="1" Tag="Size" Click="OnHeaderClick"
                                Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Right" Content="大小" />
                        <Button x:Name="FilesHeader" Grid.Column="2" Tag="Files" Click="OnHeaderClick"
                                Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Right" Content="文件" />
                        <Button x:Name="FoldersHeader" Grid.Column="3" Tag="Folders" Click="OnHeaderClick"
                                Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Right" Content="文件夹" />
                        <Button x:Name="PercentHeader" Grid.Column="4" Tag="Percent" Click="OnHeaderClick"
                                Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="占上一层 %" />
                        <TextBlock Grid.Column="5" Text="较上次" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Button x:Name="ModifiedHeader" Grid.Column="6" Tag="Modified" Click="OnHeaderClick"
                                Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Right" Content="上次修改" />
                    </Grid>

                    <ListView x:Name="TreeList" Grid.Row="1" SelectionMode="Single" DoubleTapped="OnRowDoubleTapped">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="MinHeight" Value="30" />
                                <Setter Property="Padding" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="tree:DiskTreeRow">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="110" />
                                    </Grid.ColumnDefinitions>

                                    <Grid Grid.Column="0">
                                        <Grid Margin="{x:Bind local:DiskAnalyzerView.IndentFor(Depth)}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="{x:Bind local:DiskAnalyzerView.BarStar(PercentOfParent)}" />
                                                <ColumnDefinition Width="{x:Bind local:DiskAnalyzerView.RestStar(PercentOfParent)}" />
                                            </Grid.ColumnDefinitions>
                                            <Rectangle Fill="{StaticResource FolderBarBrush}" Opacity="0.55" />
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                                                    Margin="{x:Bind local:DiskAnalyzerView.IndentFor(Depth)}">
                                            <Button Width="22" Height="22" Padding="0" Background="Transparent" BorderThickness="0" Click="OnExpanderClick">
                                                <FontIcon FontSize="10"
                                                          Glyph="{x:Bind local:DiskAnalyzerView.ExpanderGlyph(IsExpanded, HasChildren), Mode=OneWay}" />
                                            </Button>
                                            <FontIcon FontSize="16" Foreground="{StaticResource FolderIconBrush}"
                                                      Glyph="{x:Bind local:DiskAnalyzerView.IconGlyph(Kind)}" />
                                            <TextBlock Text="{x:Bind PercentText}" MinWidth="58" TextAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Grid.Column="1" Text="{x:Bind SizeText}" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind FilesText}" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind FoldersText}" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" />

                                    <Border Grid.Column="4" Margin="4,3" BorderThickness="1"
                                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">
                                        <Grid>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="{x:Bind local:DiskAnalyzerView.BarStar(PercentOfParent)}" />
                                                    <ColumnDefinition Width="{x:Bind local:DiskAnalyzerView.RestStar(PercentOfParent)}" />
                                                </Grid.ColumnDefinitions>
                                                <Rectangle Fill="{StaticResource PercentBarBrush}" Opacity="0.7" />
                                            </Grid>
                                            <TextBlock Text="{x:Bind PercentText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>

                                    <TextBlock Grid.Column="5" Text="{x:Bind ChangeText}" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"
                                               Foreground="{x:Bind local:DiskAnalyzerView.ChangeBrush(ChangeText)}" />
                                    <TextBlock Grid.Column="6" Text="{x:Bind ModifiedText}" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </PivotItem>

            <PivotItem x:Name="SteamTab" Header="Steam 游戏">
                <ListView x:Name="GamesList" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:GameRow">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Detail}" VerticalAlignment="Center" />
                                <Button Grid.Column="2" Content="卸载" Tag="{x:Bind AppId}" Click="OnUninstallClick" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </PivotItem>
        </Pivot>
    </Grid>
</Page>
