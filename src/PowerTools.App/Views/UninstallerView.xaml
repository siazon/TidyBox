<Page
    x:Class="PowerTools.App.Views.UninstallerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PowerTools.App.Views"
    AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop"
    xmlns:model="using:PowerTools.Modules.Uninstaller.Model">

    <Page.Resources>
        <!-- Shown for apps whose own icon cannot be found. -->
        <SvgImageSource x:Key="AppPlaceholder" UriSource="ms-appx:///Assets/app-placeholder.svg" />
    </Page.Resources>

    <Grid Margin="24,16,24,16" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" PlaceholderText="搜索名称、发布者…（也可以把快捷方式或程序文件拖进来）" TextChanged="OnFilterChanged" />
            <ComboBox x:Name="SourceFilter" Grid.Column="1" SelectedIndex="0" SelectionChanged="OnFilterChanged" MinWidth="130"
                      AutomationProperties.Name="来源筛选">
                <ComboBoxItem Content="全部来源" />
                <ComboBoxItem Content="桌面程序" Tag="Win32" />
                <ComboBoxItem Content="商店应用" Tag="Store" />
                <ComboBoxItem Content="Steam 游戏" Tag="Steam" />
            </ComboBox>
            <ComboBox x:Name="SortBox" Grid.Column="2" SelectedIndex="0" SelectionChanged="OnFilterChanged" MinWidth="130"
                      AutomationProperties.Name="排序">
                <ComboBoxItem Content="按名称" Tag="name" />
                <ComboBoxItem Content="按大小" Tag="size" />
                <ComboBoxItem Content="最近安装" Tag="date" />
            </ComboBox>
            <Button x:Name="RefreshButton" Grid.Column="3" Content="刷新" Click="OnRefreshClick" />
            <Button x:Name="UninstallButton" Grid.Column="4" Content="卸载" IsEnabled="False" Click="OnUninstallClick"
                    Style="{StaticResource AccentButtonStyle}" />
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Text="正在读取已安装的程序…" />
            <Button x:Name="BatchUninstallButton" Grid.Column="1" Content="批量卸载…" IsEnabled="False" Click="OnBatchUninstallClick"
                    ToolTipService.ToolTip="勾选多个程序左侧的复选框后点这里，会先显示预计释放的总空间再确认" />
        </Grid>

        <ListView x:Name="AppList" Grid.Row="2" SelectionMode="Single" SelectionChanged="OnSelectionChanged">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="MinHeight" Value="48" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:AppRow">
                    <Grid ColumnSpacing="12" AutomationProperties.Name="{x:Bind DisplayName}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>
                        <CheckBox IsChecked="{x:Bind IsChecked, Mode=TwoWay}" Checked="OnRowCheckChanged" Unchecked="OnRowCheckChanged"
                                  VerticalAlignment="Center" MinWidth="0" AutomationProperties.Name="{x:Bind DisplayName}" />
                        <!-- The plate keeps white line-art icons (some Store apps) visible on a light theme; the shopping bag is the placeholder. -->
                        <Grid Grid.Column="1" Width="32" Height="32" CornerRadius="6" VerticalAlignment="Center"
                              Background="#66808080">
                            <Image Source="{StaticResource AppPlaceholder}" Width="20" Height="20" Visibility="{x:Bind PlaceholderVisibility, Mode=OneWay}" />
                            <Image Source="{x:Bind Icon, Mode=OneWay}" Width="24" Height="24" Visibility="{x:Bind IconVisibility, Mode=OneWay}" />
                        </Grid>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{x:Bind DisplayName}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="新" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                           Visibility="{x:Bind local:UninstallerView.Show(IsNew)}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind Subtitle, Mode=OneWay}" Opacity="0.6" TextTrimming="CharacterEllipsis" FontSize="12" />
                        </StackPanel>
                        <TextBlock Grid.Column="3" Text="{x:Bind SourceText}" Opacity="0.7" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="4" Text="{x:Bind SizeText, Mode=OneWay}" Opacity="0.7" VerticalAlignment="Center"
                                   ToolTipService.ToolTip="{x:Bind SizeTooltip, Mode=OneWay}" />
                        <TextBlock Grid.Column="5" Text="{x:Bind DateText}" Opacity="0.7" VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Border x:Name="ResiduePanel" Grid.Row="3" Visibility="Collapsed" Padding="16,12" CornerRadius="6" BorderThickness="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <StackPanel Spacing="8">
                <TextBlock x:Name="ResidueTitle" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="勾选后文件夹会移到回收站（需要管理员权限的移到 C:\ProgramData\PowerTools\Quarantine）；注册表项会先备份成 .reg 文件再删除，双击备份文件即可还原。"
                           TextWrapping="Wrap" Opacity="0.7" />
                <ListView x:Name="ResidueList" SelectionMode="None" MaxHeight="220">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:ResidueRow">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{x:Bind IsChecked, Mode=TwoWay}" IsEnabled="{x:Bind CanSelect}" MinWidth="0"
                                          AutomationProperties.Name="{x:Bind Path}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Path}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Detail}" Opacity="0.6" FontSize="12" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock x:Name="ResidueResult" Visibility="Collapsed" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="RemoveButton" Content="删除选中项" Click="OnRemoveResidueClick" />
                    <Button Content="忽略" Click="OnDismissResidueClick" />
                    <Button Content="清空回收站" Click="OnEmptyRecycleBinClick"
                            ToolTipService.ToolTip="移到回收站的文件在这里之前不会真正释放磁盘空间；清空回收站会清空整台机器的回收站，不止这次删除的内容" />
                    <Button Content="管理隔离区" Click="OnManageQuarantineClick"
                            ToolTipService.ToolTip="查看需要管理员权限才能删除的残留占用了多少空间，并可以清空" />
                    <TextBlock x:Name="RecycleBinUsageText" Opacity="0.7" VerticalAlignment="Center" />
                    <Border x:Name="RecycleBinUsageBarContainer" Width="90" Height="10" CornerRadius="5" VerticalAlignment="Center"
                            Visibility="Collapsed"
                            Background="{ThemeResource ControlFillColorSecondaryBrush}" BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="RecycleBinUsageBarFillColumn" Width="0*" />
                                <ColumnDefinition x:Name="RecycleBinUsageBarRestColumn" Width="100*" />
                            </Grid.ColumnDefinitions>
                            <Rectangle Grid.Column="0" Fill="{ThemeResource SystemFillColorCautionBrush}" RadiusX="5" RadiusY="5" />
                        </Grid>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>
