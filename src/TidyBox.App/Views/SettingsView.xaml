<Page
    x:Class="TidyBox.App.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer>
        <StackPanel Margin="24,16,24,16" Spacing="16" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Text="设置" Style="{StaticResource TitleTextBlockStyle}" />

            <TextBlock Text="数据与清理" FontWeight="SemiBold" FontSize="16" />
            <Border Padding="16,12" CornerRadius="6" BorderThickness="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <StackPanel Spacing="16">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="隔离区" FontWeight="SemiBold" />
                            <TextBlock Text="清理 Program Files/ProgramData 下的残留时，需要管理员权限的文件会先移到这里，而不是直接删除。"
                                       TextWrapping="Wrap" Opacity="0.7" />
                            <TextBlock x:Name="QuarantineUsageText" Opacity="0.7" FontSize="12" />
                        </StackPanel>
                        <Button x:Name="PurgeQuarantineButton" Grid.Column="1" VerticalAlignment="Top" Click="OnPurgeQuarantineClick">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                <TextBlock Text="查看/清空隔离区" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="回收站" FontWeight="SemiBold" />
                            <TextBlock Text="清理残留时移到回收站的文件，在这里清空之前不会真正释放磁盘空间。"
                                       TextWrapping="Wrap" Opacity="0.7" />
                            <TextBlock x:Name="RecycleBinUsageText" Opacity="0.7" FontSize="12" />
                        </StackPanel>
                        <Button Grid.Column="1" VerticalAlignment="Top" Click="OnEmptyRecycleBinClick">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                <TextBlock Text="清空回收站" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="注册表备份" FontWeight="SemiBold" />
                            <TextBlock Text="删除残留注册表项之前导出的 .reg 备份，双击可以还原。卸载 TidyBox 不会自动删除这些文件。"
                                       TextWrapping="Wrap" Opacity="0.7" />
                            <TextBlock x:Name="RegistryBackupPathText" Opacity="0.7" FontSize="12" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button Grid.Column="1" VerticalAlignment="Top" Click="OnOpenRegistryBackupFolderClick">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE838;" FontSize="14" />
                                <TextBlock Text="打开文件夹" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="右键菜单改动" FontWeight="SemiBold" />
                            <TextBlock Text="停用某个右键菜单项、或恢复完整（经典）右键菜单，这些改动保存在 Windows 注册表中，卸载 TidyBox 不会自动恢复；可以在“右键菜单管理”页里逐项或一次性恢复。"
                                       TextWrapping="Wrap" Opacity="0.7" />
                        </StackPanel>
                        <Button Grid.Column="1" VerticalAlignment="Top" Click="OnGoToContextMenuClick">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xF2C7;" FontSize="14" />
                                <TextBlock Text="前往右键菜单管理" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Text="文件整理" FontWeight="SemiBold" FontSize="16" />
            <Border Padding="16,12" CornerRadius="6" BorderThickness="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <StackPanel Spacing="16">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="多少天没动算“久未动”" FontWeight="SemiBold" />
                            <TextBlock Text="文件的创建和修改时间都超过这么多天，就会出现在文件整理页的“久未动的”里（1 到 3650 天，默认 90 天）。"
                                       TextWrapping="Wrap" Opacity="0.7" />
                        </StackPanel>
                        <NumberBox x:Name="StaleDaysBox" Grid.Column="1" VerticalAlignment="Top" Width="150"
                                   Minimum="1" Maximum="3650" SmallChange="1" LargeChange="10"
                                   SpinButtonPlacementMode="Inline" ValidationMode="InvalidInputOverwritten"
                                   AutomationProperties.Name="久未动的天数" ValueChanged="OnTidyOptionChanged" />
                    </Grid>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="刚写入的文件先不动（分钟）" FontWeight="SemiBold" />
                            <TextBlock Text="最近这么多分钟内被写入过的文件不会被整理，也不会被移到回收站，避免动到还没下载完的文件（0 到 1440 分钟，默认 5 分钟；0 表示不等待，正在被使用的文件仍会跳过）。"
                                       TextWrapping="Wrap" Opacity="0.7" />
                        </StackPanel>
                        <NumberBox x:Name="RecentMinutesBox" Grid.Column="1" VerticalAlignment="Top" Width="150"
                                   Minimum="0" Maximum="1440" SmallChange="1" LargeChange="10"
                                   SpinButtonPlacementMode="Inline" ValidationMode="InvalidInputOverwritten"
                                   AutomationProperties.Name="刚写入的等待分钟数" ValueChanged="OnTidyOptionChanged" />
                    </Grid>

                    <Button Content="恢复默认值" HorizontalAlignment="Left" Click="OnResetTidyOptionsClick" />
                </StackPanel>
            </Border>

            <TextBlock Text="外观" FontWeight="SemiBold" FontSize="16" />
            <Border Padding="16,12" CornerRadius="6" BorderThickness="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="主题" VerticalAlignment="Center" FontWeight="SemiBold" />
                    <ComboBox x:Name="ThemeCombo" Grid.Column="1" MinWidth="140" SelectionChanged="OnThemeChanged">
                        <ComboBoxItem Content="跟随系统" Tag="Default" />
                        <ComboBoxItem Content="浅色" Tag="Light" />
                        <ComboBoxItem Content="深色" Tag="Dark" />
                    </ComboBox>
                </Grid>
            </Border>

            <!-- Shown only when there is a feedback server to send to (see FeedbackConfig). -->
            <StackPanel x:Name="FeedbackSection" Spacing="16" Visibility="Collapsed">
                <TextBlock Text="反馈" FontWeight="SemiBold" FontSize="16" />
                <Border Padding="16,12" CornerRadius="6" BorderThickness="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="发送反馈" FontWeight="SemiBold" />
                            <TextBlock Text="告诉我们遇到的问题或想要的功能。只有你点击“发送”时才会联网。" TextWrapping="Wrap" Opacity="0.7" />
                            <TextBlock x:Name="FeedbackStatusText" Opacity="0.7" FontSize="12" />
                        </StackPanel>
                        <Button Grid.Column="1" VerticalAlignment="Top" Click="OnSendFeedbackClick">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE939;" FontSize="14" />
                                <TextBlock Text="发送反馈…" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </StackPanel>

            <TextBlock Text="关于" FontWeight="SemiBold" FontSize="16" />
            <Border Padding="16,12" CornerRadius="6" BorderThickness="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="VersionText" FontWeight="SemiBold" Tapped="OnVersionTapped" />
                    <TextBlock x:Name="DeveloperHint" FontSize="12" Opacity="0.7" Visibility="Collapsed" />
                    <TextBlock x:Name="PrivacyText" Text="TidyBox 不会联网，也不会收集或上传任何个人数据。" TextWrapping="Wrap" Opacity="0.7" />
                    <Button Click="OnShowThirdPartyNoticesClick" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE946;" FontSize="14" />
                            <TextBlock Text="查看第三方声明" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
