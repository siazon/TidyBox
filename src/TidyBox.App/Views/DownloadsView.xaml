<Page
    x:Class="TidyBox.App.Views.DownloadsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TidyBox.App.Views"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <Style x:Key="StretchItemStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <DataTemplate x:Key="ProposalTemplate" x:DataType="local:ProposalRow">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <CheckBox IsChecked="{x:Bind IsChecked, Mode=TwoWay}" IsEnabled="{x:Bind CanCheck}" MinWidth="0"
                          Click="OnProposalCheckClick" AutomationProperties.Name="{x:Bind Name}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind Detail}" Opacity="0.6" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="StaleTemplate" x:DataType="local:StaleRow">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <CheckBox IsChecked="{x:Bind IsChecked, Mode=TwoWay}" MinWidth="0"
                          Click="OnStaleCheckClick" AutomationProperties.Name="{x:Bind Name}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind Detail}" Opacity="0.6" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="KeptTemplate" x:DataType="local:StaleRow">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind Detail}" Opacity="0.6" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Content="放回" Click="OnUnkeepClick" AutomationProperties.Name="放回提醒列表" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="BatchTemplate" x:DataType="local:BatchRow">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind Title}" />
                    <TextBlock Text="{x:Bind Note}" Visibility="{x:Bind NoteVisibility}" Opacity="0.6" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Content="撤销" Visibility="{x:Bind UndoVisibility}" Click="OnUndoClick" AutomationProperties.Name="撤销这次整理" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer x:Name="PageScroll">
        <StackPanel Margin="24,16,24,16" Spacing="16">

            <StackPanel Spacing="4">
                <TextBlock Text="文件整理" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock x:Name="PathText" Opacity="0.7" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="ChangeFolderButton" Content="更改文件夹…" Click="OnChangeFolderClick" />
                    <Button x:Name="ResetFolderButton" Content="恢复为下载文件夹" Click="OnResetFolderClick" Visibility="Collapsed" />
                </StackPanel>
                <TextBlock x:Name="SummaryText" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="RefreshButton" Content="重新扫描" Click="OnRefreshClick" />
                    <Button x:Name="CancelButton" Content="取消" Click="OnCancelClick" Visibility="Collapsed" />
                </StackPanel>
                <ProgressBar x:Name="BusyBar" IsIndeterminate="True" Visibility="Collapsed" />
                <TextBlock x:Name="StatusText" TextWrapping="Wrap" Opacity="0.7" />
                <TextBlock x:Name="ResultText" TextWrapping="Wrap" />
            </StackPanel>

            <Border Padding="16,12" CornerRadius="6" BorderThickness="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="TidyTitle" FontWeight="SemiBold" />
                    <TextBlock Text="按文件类型把文件整理进所选文件夹里的分类文件夹（默认是下载文件夹，可以点“更改文件夹…”换成别的）。点“执行所选操作”并确认后才会移动，移动后可以在“历史”里撤销。没有匹配规则的文件不会动。"
                               TextWrapping="Wrap" Opacity="0.7" />
                    <StackPanel x:Name="GroupsPanel" Spacing="4" />
                    <Button x:Name="TidyButton" Click="OnTidyClick" />
                </StackPanel>
            </Border>

            <Border Padding="16,12" CornerRadius="6" BorderThickness="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="StaleTitle" FontWeight="SemiBold" />
                    <TextBlock x:Name="StaleHint"
                               TextWrapping="Wrap" Opacity="0.7" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ComboBox x:Name="TypeFilter" MinWidth="140" SelectionChanged="OnFilterChanged" AutomationProperties.Name="按类型筛选" />
                        <Button Content="全选当前筛选结果" Click="OnSelectAllClick" />
                    </StackPanel>
                    <ListView x:Name="StaleList" SelectionMode="None" MaxHeight="420"
                              ItemTemplate="{StaticResource StaleTemplate}" ItemContainerStyle="{StaticResource StretchItemStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="RecycleButton" Click="OnRecycleClick" />
                        <Button x:Name="KeepButton" Click="OnKeepClick" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Expander x:Name="KeptExpander" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <ListView x:Name="KeptList" SelectionMode="None" MaxHeight="260"
                          ItemTemplate="{StaticResource KeptTemplate}" ItemContainerStyle="{StaticResource StretchItemStyle}" />
            </Expander>

            <Expander x:Name="HistoryExpander" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <ListView x:Name="HistoryList" SelectionMode="None" MaxHeight="260"
                          ItemTemplate="{StaticResource BatchTemplate}" ItemContainerStyle="{StaticResource StretchItemStyle}" />
            </Expander>

        </StackPanel>
    </ScrollViewer>
</Page>
