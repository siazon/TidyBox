<ContentDialog
    x:Class="TidyBox.App.Feedback.FeedbackDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="发送反馈"
    PrimaryButtonText="发送"
    CloseButtonText="取消"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="False"
    PrimaryButtonClick="OnSendClick">

    <StackPanel Spacing="12" MinWidth="440">
        <ComboBox x:Name="KindCombo" Header="类型" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="OnKindChanged">
            <ComboBoxItem Content="建议" Tag="Suggestion" />
            <ComboBoxItem Content="错误" Tag="Error" />
            <ComboBoxItem Content="其他" Tag="Other" />
        </ComboBox>

        <TextBox x:Name="MessageBox" Header="内容" AcceptsReturn="True" TextWrapping="Wrap"
                 MinHeight="120" MaxHeight="220" MaxLength="4000" TextChanged="OnMessageChanged" />

        <TextBox x:Name="ContactBox" Header="联系方式（可选，邮箱、QQ、微信均可）" MaxLength="200" />

        <StackPanel x:Name="LogPanel" Spacing="6" Visibility="Collapsed">
            <CheckBox x:Name="AttachLogsBox" Content="附带最近的运行日志" IsChecked="True" />
            <Expander Header="查看将发送的日志" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <TextBox x:Name="LogPreview" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                         MaxHeight="160" FontFamily="Consolas" FontSize="12" />
            </Expander>
        </StackPanel>

        <TextBlock Text="会发送：以上内容和 TidyBox 版本号。服务器只保存 IP 的哈希值，用于防止刷屏。"
                   TextWrapping="Wrap" Opacity="0.7" FontSize="12" />

        <TextBlock x:Name="StatusText" TextWrapping="Wrap" Visibility="Collapsed" />
    </StackPanel>
</ContentDialog>
